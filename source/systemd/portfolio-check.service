[Unit]
Description=Rocket Stock Scanner - Portfolio Check
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /srv/svarkor/builds/rocket-stock-scanner/rocket/portfolio_check_cron.py
WorkingDirectory=/srv/svarkor/builds/rocket-stock-scanner
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/srv/svarkor/builds/rocket-stock-scanner/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

# scan_pro.env.example — TEMPLATE ONLY. Placeholders, never real values.
#
# Setup: copy to config/scan_pro.env (which is gitignored) and fill in real values:
#     cp config/scan_pro.env.example config/scan_pro.env
#
# RULES (MC#939 — a real bot token was committed to this public repo once already):
#   * config/scan_pro.env is UNTRACKED and must stay untracked. Never `git add -f` it.
#   * NEVER put a real token/chat id in this .example file, in code, or in any
#     committed file — not even "temporarily to fix the bot". If the bot is broken
#     because config is missing, the fix is to (re)create config/scan_pro.env
#     locally, NOT to commit credentials.
#   * The pre-push secret scan will block pushes containing token-shaped values.

# Telegram bot token from @BotFather (format: <digits>:<35 chars>)
SCAN_PRO_TELEGRAM_BOT_TOKEN=changeme

# Telegram chat id that gets admin commands + daily pushes (digits only)
SCAN_PRO_ADMIN_CHAT_ID=changeme

#!/usr/bin/env python3
"""Check all recent messages from bot."""
import requests
import os

secret_path = '/home/svarkor/.hermes/.secrets/svarkor.env'
token = None
with open(secret_path) as f:
    for line in f:
        stripped = line.strip()
        if stripped.startswith('#') or '=' not in stripped:
            continue
        key, val = stripped.split('=', 1)
        key = key.strip()
        if 'SCAN_PRO_TELEGRAM_BOT_TOKEN' in key or 'TELEGRAM_BOT_TOKEN' in key:
            token = val.strip()
            break

if not token:
    print("No token"); os._exit(1)

api_url = f"https://api.telegram.org/bot{token}/getUpdates"
data = {"offset": -1, "limit": 50, "timeout": 3}
try:
    resp = requests.post(api_url, json=data, timeout=10)
    result = resp.json()
    if result.get('ok'):
        updates = result.get('result', [])
        print(f"Total updates: {len(updates)}")
        for upd in updates[-10:]:
            msg = upd.get('message', {})
            text = msg.get('text', '')
            chat = msg.get('chat', {}).get('title', 'unknown')
            print(f"  [{msg.get('message_id')}] {chat}: {text[:100]}")
    else:
        print(f"API error: {result.get('description')}")
except Exception as e:
    print(f"Error: {e}")
